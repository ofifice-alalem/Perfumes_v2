{
    "name": "taqniya-cloud-pos",
    "version": "1.0.0",
    "description": "منظومة السحابة المتكاملة لإدارة نقاط البيع والمتاجر — شركة تقنية السحابة",
    "author": "شركة تقنية السحابة",
    "private": true,
    "type": "module",
    "main": "electron/main.js",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "desktop": "npx electron electron/main.js",
        "desktop:pos": "npx electron electron/launcher-pos.js",
        "desktop:settings": "npx electron electron/launcher-settings.js",
        "build:exe": "npx electron-builder --win nsis"
    },
    "build": {
        "appId": "com.taqniyacloud.pos",
        "productName": "منظومة السحابة",
        "electronVersion": "33.2.0",
        "publish": null,
        "directories": {
            "output": "dist"
        },
        "files": [
            "electron/**/*",
            "public/build/**/*",
            "public/images/logo.png",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "runtime/php",
                "to": "php"
            },
            {
                "from": "app",
                "to": "server/app"
            },
            {
                "from": "bootstrap",
                "to": "server/bootstrap"
            },
            {
                "from": "config",
                "to": "server/config"
            },
            {
                "from": "database",
                "to": "server/database"
            },
            {
                "from": "public",
                "to": "server/public",
                "filter": [
                    "**/*",
                    "!storage",
                    "!storage/**",
                    "!hot",
                    "!images/receipt/*",
                    "!images/logo_*"
                ]
            },
            {
                "from": "resources/views",
                "to": "server/resources/views"
            },
            {
                "from": "routes",
                "to": "server/routes"
            },
            {
                "from": "storage",
                "to": "server/storage",
                "filter": [
                    "**/*",
                    "!app/backups/**/*",
                    "!framework/cache/data/**/*",
                    "!framework/sessions/**/*",
                    "!framework/views/**/*",
                    "!logs/*"
                ]
            },
            {
                "from": "vendor",
                "to": "server/vendor"
            },
            {
                "from": "artisan",
                "to": "server/artisan"
            },
            {
                "from": ".env.example",
                "to": "server/.env.example"
            }
        ],
        "extraMetadata": {
            "main": "electron/main.js"
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "public/images/logo.png"
        },
        "compression": "store",
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": false,
            "createStartMenuShortcut": true,
            "shortcutName": "منظومة السحابة",
            "include": "electron/installer.nsh",
            "differentialPackage": false
        }
    },
    "devDependencies": {
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "autoprefixer": "^10.5.0",
        "clsx": "^2.1.1",
        "concurrently": "^9.0.1",
        "electron": "^33.2.0",
        "electron-builder": "^26.18.0",
        "laravel-vite-plugin": "^3.0.1",
        "lucide-react": "^1.11.0",
        "postcss": "^8.5.12",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^3.4.19",
        "typescript": "^6.0.3",
        "vite": "^8.0.0",
        "vite-plugin-compression": "^0.5.1"
    },
    "dependencies": {
        "@base-ui/react": "^1.4.1",
        "@fontsource-variable/geist": "^5.2.8",
        "@fontsource/tajawal": "^5.2.7",
        "@inertiajs/react": "^3.0.3",
        "@vitejs/plugin-react": "^6.0.1",
        "class-variance-authority": "^0.7.1",
        "qrcode.react": "^4.2.0",
        "react": "^19.2.5",
        "react-barcode": "^1.6.1",
        "react-dom": "^19.2.5",
        "react-router-dom": "^7.14.2",
        "shadcn": "^4.5.0",
        "tailwindcss-animate": "^1.0.7",
        "tw-animate-css": "^1.4.0"
    }
}
